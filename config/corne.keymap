#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NUM  1
#define ACT  2
#define FUN  3

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &kp Q         &kp W         &kp E         &kp R         &kp T             &kp Y         &kp U         &kp I         &kp O         &kp P
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &hm LGUI A    &hm RALT S    &hm LCTRL D   &hm LSHFT F   &kp G             &kp H         &hm RSHFT J   &hm LCTRL K   &hm RALT L    &hm LGUI SEMI
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp Z         &hm LALT X    &kp C         &kp V         &kp B             &kp N         &kp M         &kp COMMA     &hm LALT DOT  &kp FSLH
// ╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼───┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                &lt FUN DEL   &lt NUM BSPC  &lt ACT TAB       &lt ACT RET   &lt NUM SPACE &lt FUN ESC
//                             ╰─────────────┴─────────────┴─────────────┴───┴─────────────┴─────────────┴─────────────╯
            >;
        };

        // Numbers on home row, symbols on upper row
        num_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &EXCL         &kp AT        &kp HASH      &kp DLLR      &PRCNT            &kp CARET     &kp AMPS      &kp ASTRK     &kp MINUS     &kp EQUAL 
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp N1        &kp N2        &kp N3        &kp N4        &kp N5            &kp N6        &kp N7        &kp N8        &kp N9        &kp N0
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LBLK      &RBKT         &LPAR         &RPAR         &trans            &kp GRAVE     &kp LBRC      &kp RPRC      &kp SQT       &kp BSLH 
// ╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼───┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                &trans        &trans        &trans            &trans        &trans        &trans
//                             ╰─────────────┴─────────────┴─────────────┴───┴─────────────┴─────────────┴─────────────╯
            >;
        };

        // Symbols — brackets/pairs on left · operators/punctuation on right
        act_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3      &kp HOME      &kp PG_UP     &kp PG_DN     &END          &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp LBKT      &kp RBKT      &kp LBRC      &kp RBRC      &kp PIPE          &kp LEFT      &kp UP        &kp DOWN      &kp RIGHT     &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans            &trans        &trans        &trans        &trans        &trans
// ╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼───┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                &trans        &trans        &trans            &trans        &trans        &trans
//                             ╰─────────────┴─────────────┴─────────────┴───┴─────────────┴─────────────┴─────────────╯
            >;
        };

        // F1–F10 on top row · F11–F12 on right home row
        fun_layer {
            bindings = <
// ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮   ╭─────────────┬─────────────┬─────────────┬─────────────┬─────────────╮
    &trans        &trans        &trans        &trans        &trans             &trans        &trans        &trans        &trans        &trans
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &kp F1        &kp F2        &kp F3        &kp F4        &kp F5             &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
// ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤   ├─────────────┼─────────────┼─────────────┼─────────────┼─────────────┤
    &trans        &trans        &trans        &trans        &trans             &trans        &trans        &trans        &kp F11       &kp F12
// ╰─────────────┴─────────────┴─────────────┼─────────────┼─────────────┼───┼─────────────┼─────────────┼─────────────┴─────────────┴─────────────╯
                                &trans        &trans        &trans             &trans        &trans        &trans
//                             ╰─────────────┴─────────────┴─────────────┴───┴─────────────┴─────────────┴─────────────╯
            >;
        };
    };
};
